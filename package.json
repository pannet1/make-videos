{
  "name": "make-videos",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "vite dev",
    "studio": "rendiv studio src/index.tsx",
    "render": "rendiv render src/index.tsx MyVideo out/my-video.mp4",
    "still": "rendiv still src/index.tsx MyVideo out/still.png",
    "compositions": "rendiv compositions src/index.tsx",
    "render:navaratri": "./render.sh NavaratriSadhana out/navaratri-sadhana.mp4 --concurrency 8 --preset medium --crf 16",
    "render:navaratri-draft": "./render.sh NavaratriSadhana out/navaratri-draft.mp4 --concurrency 8 --preset ultrafast --crf 28",
    "still:navaratri-thumb": "./render.sh NavaratriThumbnail out/thumbnail.png --still"
  },
  "dependencies": {
    "@rendiv/core": "^0.2.0",
    "@rendiv/noise": "^0.2.6",
    "@rendiv/player": "^0.2.0",
    "@rendiv/cli": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
