{
  "name": "make-videos",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "vite dev",
    "studio": "rendiv studio src/index.tsx",
    "render": "rendiv render src/index.tsx MyVideo out/my-video.mp4",
    "still": "rendiv still src/index.tsx MyVideo out/still.png",
    "compositions": "rendiv compositions src/index.tsx",
    "render:navaratri": "./render.sh NavaratriSadhana",
    "render:navaratri-draft": "./render.sh NavaratriSadhana --draft",
    "watch": "./scripts/watch-folder.sh",
    "still:navaratri-thumb": "./render.sh NavaratriThumbnail --still",
    "verify:bathroom": "./scripts/verify-bathroom-pattern.sh",
    "package:bathroom": "./scripts/stage-bathroom-package.sh",
    "package:bathroom:check": "./scripts/stage-bathroom-package.sh --check",
    "manifest:bathroom": "python3 ./scripts/generate-bathroom-manifest.py",
    "manifest:bathroom:check": "python3 ./scripts/generate-bathroom-manifest.py --check",
    "timings:bathroom": "./scripts/timings.sh bathroom-pattern",
    "vo:bathroom": "./scripts/generate-vo.sh bathroom-pattern en-IN-PrabhatNeural",
    "check:bathroom": "pnpm run verify:bathroom && pnpm run qc:bathroom",
    "build:bathroom": "pnpm run manifest:bathroom && pnpm run package:bathroom && pnpm run verify:bathroom && pnpm run qc:bathroom",
    "render:bathroom": "./render.sh BathroomPattern out/bathroom-pattern.mp4",
    "render:bathroom:stop": "./render.sh BathroomPattern out/bathroom-pattern.mp4 --stop",
    "render:bathroom-draft": "./render.sh BathroomPattern --draft",
    "render:bathroom-draft:stop": "./render.sh BathroomPattern --draft --stop",
    "still:bathroom-thumb": "./render.sh BathroomThumbnail --still",
    "still:bathroom-thumb:stop": "./render.sh BathroomThumbnail --still --stop",
    "still:bathroom": "./render.sh BathroomPattern --still",
    "still:bathroom:stop": "./render.sh BathroomPattern --still --stop",
    "still:bathroom-scenes": "./scripts/render-bathroom-scenes.sh",
    "still:bathroom-scenes:stop": "./scripts/render-bathroom-scenes.sh --stop",
    "qc:bathroom": "./scripts/qc-bathroom.sh",
    "qc:bathroom:strict": "./scripts/qc-bathroom.sh --strict",
    "clean:bathroom": "rm -rf dist/bathroom-pattern-youtube videos/bathroom-pattern/edit/qc src/__ephemeral__.tsx out/bathroom*.png out/bathroom-pattern-draft.mp4 && (docker stop rendiv 2>/dev/null || true)",
    "stop:bathroom": "docker stop rendiv 2>/dev/null || true",
    "test": "pnpm run check:bathroom"
  },
  "dependencies": {
    "@rendiv/cli": "^0.2.6",
    "@rendiv/core": "^0.2.6",
    "@rendiv/noise": "^0.2.6",
    "@rendiv/player": "^0.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
